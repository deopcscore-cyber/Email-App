# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Public origin of the web app; OAuth callbacks and cookies are scoped to it.
APP_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://novamail:novamail@localhost:5432/novamail
REDIS_URL=redis://localhost:6379

# 32-byte hex key for AES-256-GCM encryption of provider refresh tokens.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Google OAuth ────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth ─────────────────────────────────────────────────
# https://portal.azure.com → App registrations
# Redirect URI (Web): {APP_ORIGIN}/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── OpenAI (Phase 5) ────────────────────────────────────────────────
OPENAI_API_KEY=
