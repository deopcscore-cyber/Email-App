{
  "name": "novamail",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @novamail/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @novamail/api exec prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
